{
  "name": "caesium-image-compressor",
  "private": true,
  "version": "3.0.0-alpha.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src/**/*.{js,ts,tsx} --no-warn-ignored",
    "lint:fix": "eslint src/**/*.{js,ts,tsx} --no-warn-ignored --fix",
    "format": "prettier --write src/**/*.{js,ts,tsx}",
    "verify": "npm run check && npm run lint && prettier --check src/**/*.{js,ts,tsx}"
  },
